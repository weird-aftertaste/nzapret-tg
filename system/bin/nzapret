#!/system/bin/sh
# nzapret-tg — Telegram-only management utility

MODDIR="/data/adb/modules/nzapret"
EVENTLOG="$MODDIR/nzapret-events.log"
NZTG_BIN="$MODDIR/bin/nztg"
TGPROXY_CONF="$MODDIR/tgproxy.conf"
TG_SECRET_FILE="$MODDIR/.tg_secret"
TG_LINK_FILE="$MODDIR/.tg_link"
TG_LOGFILE="$MODDIR/nztg.log"
TG_PROCESS_NAME="nztg"
PRIVATE_DNS_INIT_FILE="$MODDIR/.private_dns_initialized"
DEFAULT_PRIVATE_DNS_HOSTNAME="xbox-dns.ru"
CHAIN="nzapret_out"

. "$MODDIR/common.sh"

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

get_version() {
    [ -f "$MODDIR/module.prop" ] && grep '^version=' "$MODDIR/module.prop" | cut -d= -f2 | tr -d '\r\n'
}

is_live_pid() {
    _pid="$1"
    [ -n "$_pid" ] || return 1
    [ -d "/proc/$_pid" ] || return 1
    _state=$(awk '/^State:/ { print $2; exit }' "/proc/$_pid/status" 2>/dev/null)
    [ "$_state" != "Z" ]
}

tg_pids() {
    for _pid in $(pgrep -x "$TG_PROCESS_NAME" 2>/dev/null); do
        is_live_pid "$_pid" && echo "$_pid"
    done
}

tg_pid() {
    for _pid in $(tg_pids); do echo "$_pid"; return 0; done
    return 1
}

tg_pid_count() {
    _n=0
    for _pid in $(tg_pids); do _n=$((_n + 1)); done
    echo "$_n"
}

tg_active() {
    [ -n "$(tg_pid)" ]
}

make_temp_file() {
    _tmp=$(mktemp 2>/dev/null)
    [ -n "$_tmp" ] || _tmp="/data/local/tmp/nzapret.$$.tmp"
    : > "$_tmp" 2>/dev/null || return 1
    echo "$_tmp"
}

get_tg_secret() {
    if [ -s "$TG_SECRET_FILE" ]; then
        tr -d '\r\n' < "$TG_SECRET_FILE"
        return 0
    fi
    [ -x "$NZTG_BIN" ] || return 1
    _sec=$("$NZTG_BIN" gensecret 2>/dev/null) || return 1
    printf '%s\n' "$_sec" > "$TG_SECRET_FILE" || return 1
    chmod 600 "$TG_SECRET_FILE" 2>/dev/null
    printf '%s' "$_sec"
}

get_tg_link() {
    ensure_tgproxy_conf
    _h=$(get_tg_conf host "$DEFAULT_TG_HOST")
    _p=$(get_tg_conf port "$DEFAULT_TG_PORT")
    _s=$(get_tg_secret) || return 1
    printf 'tg://proxy?server=%s&port=%s&secret=dd%s' "$_h" "$_p" "$_s"
}

validate_tg_dc_rules() {
    _clean=""
    while IFS= read -r _line || [ -n "$_line" ]; do
        _line=$(printf '%s' "$_line" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        [ -n "$_line" ] || continue
        _num="${_line%%:*}"; _ip="${_line#*:}"
        case "$_num" in ''|*[!0-9]*) return 1 ;; esac
        case "$_ip" in *[!0-9.]*|'') return 1 ;; esac
        _clean="${_clean}${_line}
"
    done
    printf '%s' "$_clean"
}

tg_set_single() {
    _key="$1"; _value="$2"
    ensure_tgproxy_conf
    _tmp=$(make_temp_file) || return 1
    grep -v "^$_key=" "$TGPROXY_CONF" 2>/dev/null > "$_tmp"
    printf '%s=%s\n' "$_key" "$_value" >> "$_tmp"
    mv -f "$_tmp" "$TGPROXY_CONF"
}

tg_set_dc() {
    _rules="$1"
    ensure_tgproxy_conf
    _tmp=$(make_temp_file) || return 1
    grep -v '^dc=' "$TGPROXY_CONF" 2>/dev/null > "$_tmp"
    printf '%s' "$_rules" | while IFS= read -r _r || [ -n "$_r" ]; do
        [ -n "$_r" ] && printf 'dc=%s\n' "$_r" >> "$_tmp"
    done
    mv -f "$_tmp" "$TGPROXY_CONF"
}

cleanup_legacy_nfqws() {
    killall nfqws2 2>/dev/null
    for _tbl in iptables ip6tables; do
        command -v "$_tbl" >/dev/null 2>&1 || continue
        for _hook in OUTPUT FORWARD; do
            while "$_tbl" -w -t mangle -C "$_hook" -j "$CHAIN" >/dev/null 2>&1; do
                "$_tbl" -w -t mangle -D "$_hook" -j "$CHAIN" >/dev/null 2>&1 || break
            done
        done
        "$_tbl" -w -t mangle -F "$CHAIN" >/dev/null 2>&1
        "$_tbl" -w -t mangle -X "$CHAIN" >/dev/null 2>&1
    done
}

start_service() {
    "$MODDIR/service.sh" manual || return 1
    tg_active
}

stop_service() {
    killall "$TG_PROCESS_NAME" 2>/dev/null
    _tries=20
    while tg_active && [ "$_tries" -gt 0 ]; do
        sleep 0.1 2>/dev/null || sleep 1
        _tries=$((_tries - 1))
    done
    tg_active && killall -9 "$TG_PROCESS_NAME" 2>/dev/null
    cleanup_legacy_nfqws
    ! tg_active
}

print_status_human() {
    _ver=$(get_version)
    [ -n "$_ver" ] && echo "Module version: $_ver"
    if tg_active; then
        echo "nztg: [ON] (PID: $(tg_pid))"
    else
        echo "nztg: [OFF]"
    fi
    echo "Mode: Telegram proxy only"
    echo "nfqws2: disabled"
    echo "iptables/NFQUEUE: disabled"
    echo "Host: $(get_tg_conf host "$DEFAULT_TG_HOST")"
    echo "Port: $(get_tg_conf port "$DEFAULT_TG_PORT")"
    if [ "$(get_tg_conf cf_enabled 1)" = "0" ]; then
        echo "Cloudflare proxy: disabled"
    else
        echo "Cloudflare proxy: enabled"
    fi
}

print_status_json() {
    if tg_active; then _active=true; else _active=false; fi
    _pid=$(tg_pid)
    _ver=$(get_version)
    _port=$(get_tg_conf port "$DEFAULT_TG_PORT")
    _cf=$(get_tg_conf cf_enabled 1)
    [ "$_cf" = "0" ] && _cfb=false || _cfb=true
    _dns_mode=$(get_private_dns_mode)
    _dns_host=$(get_private_dns_hostname)
    printf '{"version":"%s","active":%s,"pid":"%s","pid_count":%s,"rules_v4":0,"rules_v6":0,"domain_count":0,"google_domain_count":0,"user_domain_count":0,"user_list_attached":false,"profile":"tg-only","profile_label":"Telegram only","private_dns_available":true,"private_dns_initialized":true,"private_dns_mode":"%s","private_dns_mode_label":"%s","private_dns_hostname":"%s","private_dns_label":"%s","private_dns_default_hostname":"%s","tg_active":%s,"tg_pid":"%s","tg_port":"%s","tg_cf_enabled":%s}\n' \
        "$(json_escape "$_ver")" "$_active" "$(json_escape "$_pid")" "$(tg_pid_count)" \
        "$(json_escape "$_dns_mode")" "$(json_escape "$_dns_mode")" "$(json_escape "$_dns_host")" "$(json_escape "$_dns_host")" "$(json_escape "$DEFAULT_PRIVATE_DNS_HOSTNAME")" \
        "$_active" "$(json_escape "$_pid")" "$(json_escape "$_port")" "$_cfb"
}

print_tg_status() {
    ensure_tgproxy_conf
    if tg_active; then echo "nztgproxy: [ON] (PID: $(tg_pid))"; else echo "nztgproxy: [OFF]"; fi
    echo "Host: $(get_tg_conf host "$DEFAULT_TG_HOST")"
    echo "Port: $(get_tg_conf port "$DEFAULT_TG_PORT")"
    echo "Secret: $(get_tg_secret)"
    echo "Link: $(get_tg_link)"
    if [ "$(get_tg_conf cf_enabled 1)" = "0" ]; then
        echo "Cloudflare proxy: disabled"
    else
        _d=$(get_tg_conf cf_domain "")
        [ -n "$_d" ] && echo "Cloudflare proxy: enabled (custom: $_d)" || echo "Cloudflare proxy: enabled (auto domains)"
    fi
    echo "Datacenters:"
    get_tg_dc_lines | while IFS= read -r _dc; do [ -n "$_dc" ] && echo "  $_dc"; done
}

print_tg_status_json() {
    ensure_tgproxy_conf
    _h=$(get_tg_conf host "$DEFAULT_TG_HOST")
    _p=$(get_tg_conf port "$DEFAULT_TG_PORT")
    _cf=$(get_tg_conf cf_enabled 1)
    _cfd=$(get_tg_conf cf_domain "")
    _pre=$(get_tg_conf preresolve_enabled 1)
    _sec=$(get_tg_secret)
    _link=$(get_tg_link)
    [ "$_cf" = "0" ] && _cfb=false || _cfb=true
    [ "$_pre" = "0" ] && _preb=false || _preb=true
    tg_active && _act=true || _act=false
    _dcs=$(get_tg_dc_lines | while IFS= read -r _d; do [ -n "$_d" ] && printf '"%s",' "$(json_escape "$_d")"; done)
    _dcs=${_dcs%,}
    printf '{"host":"%s","port":"%s","secret":"%s","link":"%s","dc_redirects":[%s],"cf_enabled":%s,"cf_domain":"%s","preresolve_enabled":%s,"active":%s,"pid":"%s"}\n' \
        "$(json_escape "$_h")" "$(json_escape "$_p")" "$(json_escape "$_sec")" "$(json_escape "$_link")" "$_dcs" "$_cfb" "$(json_escape "$_cfd")" "$_preb" "$_act" "$(json_escape "$(tg_pid)")"
}

case "${1:-help}" in
    start)
        if tg_active; then echo "[!] nztg is already running. Use 'nzapret restart'."; exit 1; fi
        echo "[*] Starting Telegram proxy..."
        if start_service; then echo "[+] nztg started successfully (PID: $(tg_pid))"; else echo "[-] Failed to start nztg. Check 'nzapret log'."; exit 1; fi
        ;;
    stop)
        echo "[*] Stopping Telegram proxy..."
        stop_service && echo "[+] Stopped" || { echo "[-] Failed to stop nztg"; exit 1; }
        ;;
    restart)
        echo "[*] Restarting Telegram proxy..."
        stop_service || exit 1
        start_service && echo "[+] nztg restarted successfully (PID: $(tg_pid))" || { echo "[-] Failed to restart nztg"; exit 1; }
        ;;
    status)
        [ "$2" = "--json" ] && print_status_json || print_status_human
        ;;
    log)
        if tg_active; then echo "nztg is running (PID: $(tg_pid))"; else echo "nztg is not running"; fi
        echo ""
        echo "Last 80 lines of nztg log:"
        [ -f "$TG_LOGFILE" ] && tail -n 80 "$TG_LOGFILE" || echo "Log file not found."
        ;;
    events)
        [ -f "$EVENTLOG" ] && tail -n "${3:-30}" "$EVENTLOG" || echo "No events recorded yet."
        ;;
    tg)
        case "$2" in
            ''|status) [ "$3" = "--json" ] && print_tg_status_json || print_tg_status ;;
            link) get_tg_link; echo ;;
            open)
                _link=$(get_tg_link) || exit 1
                am start -a android.intent.action.VIEW -d "$_link" >/dev/null 2>&1 && echo "[+] Opening Telegram..." || { echo "[-] Failed to launch Telegram"; exit 1; }
                ;;
            regen-secret)
                [ -x "$NZTG_BIN" ] || { echo "[-] nztg binary missing"; exit 1; }
                _sec=$("$NZTG_BIN" gensecret 2>/dev/null) || exit 1
                printf '%s\n' "$_sec" > "$TG_SECRET_FILE" || exit 1
                chmod 600 "$TG_SECRET_FILE" 2>/dev/null
                echo "[+] New secret: $_sec"
                echo "[*] Restart nzapret to apply changes"
                ;;
            cf-test)
                _d=$(get_tg_conf cf_domain "")
                if [ "$3" = "--json" ]; then set -- --json; else set --; fi
                [ -n "$_d" ] && "$NZTG_BIN" cftest "$@" --domain "$_d" || "$NZTG_BIN" cftest "$@"
                ;;
            set)
                case "$3" in
                    host) [ -n "$4" ] || exit 1; tg_set_single host "$4" ;;
                    port) case "$4" in ''|*[!0-9]*) echo "[-] Port must be numeric"; exit 1 ;; esac; tg_set_single port "$4" ;;
                    cf) case "$4" in on|1|true|enabled) _v=1 ;; off|0|false|disabled) _v=0 ;; *) exit 1 ;; esac; tg_set_single cf_enabled "$_v" ;;
                    cf-domain) tg_set_single cf_domain "$4" ;;
                    preresolve) case "$4" in on|1|true|enabled) _v=1 ;; off|0|false|disabled) _v=0 ;; *) exit 1 ;; esac; tg_set_single preresolve_enabled "$_v" ;;
                    dc) _clean=$(printf '%s\n' "$4" | validate_tg_dc_rules) || { echo "[-] Invalid DC rules"; exit 1; }; tg_set_dc "$_clean" ;;
                    *) echo "Usage: nzapret tg set <host|port|cf|cf-domain|preresolve|dc> <value>"; exit 1 ;;
                esac
                echo "[+] Saved"
                echo "[*] Restart nzapret to apply changes"
                ;;
            *) echo "Usage: nzapret tg [status [--json]|set <key> <value>|link|open|regen-secret|cf-test [--json]]"; exit 1 ;;
        esac
        ;;
    dns)
        case "$2" in
            ''|status)
                echo "Private DNS mode: $(get_private_dns_mode)"
                _h=$(get_private_dns_hostname); [ -n "$_h" ] && echo "Provider hostname: $_h"
                ;;
            set)
                case "$3" in
                    off) put_global_setting private_dns_mode off ;;
                    auto) put_global_setting private_dns_mode opportunistic ;;
                    default) put_global_setting private_dns_specifier "$DEFAULT_PRIVATE_DNS_HOSTNAME" && put_global_setting private_dns_mode hostname ;;
                    hostname) [ -n "$4" ] || exit 1; put_global_setting private_dns_specifier "$4" && put_global_setting private_dns_mode hostname ;;
                    *) exit 1 ;;
                esac
                ;;
        esac
        ;;
    diagnose)
        echo "nzapret-tg diagnostics"
        [ -x "$NZTG_BIN" ] && echo "[OK] nztg binary present" || echo "[!!] nztg binary missing"
        tg_active && echo "[OK] nztg running (PID: $(tg_pid))" || echo "[!!] nztg not running"
        echo "[OK] nfqws2 disabled by TG-only build"
        echo "[OK] NFQUEUE rules disabled by TG-only build"
        ;;
    help|--help|-h|*)
        echo "nzapret-tg Management Utility"
        echo "Usage: nzapret <command>"
        echo ""
        echo "Commands:"
        echo "  start / stop / restart      control nztg only"
        echo "  status [--json]             Telegram-only status"
        echo "  log                         show nztg log"
        echo "  tg status [--json]          proxy status/config"
        echo "  tg link / open              Telegram proxy link"
        echo "  tg set ...                  proxy settings"
        echo "  tg regen-secret             regenerate secret"
        echo "  tg cf-test [--json]         test Cloudflare fallback"
        echo "  dns ...                     Android Private DNS helper"
        echo "  diagnose                    basic TG-only diagnostics"
        ;;
esac
